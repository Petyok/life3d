[Unit]
Description=life.petruha.ge shared counters (server/stats.py)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/life-stats/stats.py
Environment=HOST=127.0.0.1 PORT=8787
DynamicUser=yes
StateDirectory=life-stats
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
Restart=on-failure

[Install]
WantedBy=multi-user.target
